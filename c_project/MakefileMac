# MakefileMac
# usage:
#   make -f MakefileMac build
#   make -f MakefileMac run
#   make -f MakefileMac clean

SRC_DIR   := src/game_renderer
OBJ_DIR   := build/obj
BUILD_DIR := build
TARGET    := $(BUILD_DIR)/Renderer

SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c,$(OBJ_DIR)/%.o,$(SRCS))

CC := clang

WARN_FLAGS := -Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wundef -Wconversion -Wsign-conversion
DBG_FLAGS  := -g3 -O0 -fno-omit-frame-pointer
CFLAGS     := -std=c11 $(WARN_FLAGS) $(DBG_FLAGS)

INCLUDES := -Isrc/include

# Prefer sdl2-config (Homebrew installs it); fall back to pkg-config.
SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null || pkg-config --cflags sdl2 2>/dev/null)
SDL_LIBS   := $(shell sdl2-config --libs   2>/dev/null || pkg-config --libs   sdl2 2>/dev/null)

LDFLAGS := $(SDL_LIBS)

.PHONY: build run clean

build: $(TARGET)

$(TARGET): $(OBJS) | $(BUILD_DIR)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) $(SDL_CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

run: build
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
