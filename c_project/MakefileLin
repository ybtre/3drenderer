# MakefileLin
# usage:
#   make -f MakefileLin build
#   make -f MakefileLin run
#   make -f MakefileLin clean

SRC_DIR   := src/game_renderer
OBJ_DIR   := build/obj
BUILD_DIR := build
TARGET    := $(BUILD_DIR)/Renderer_lin

SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c,$(OBJ_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

CC := gcc

PKG := sdl2 SDL2_image SDL2_mixer SDL2_ttf

WARN_FLAGS := -Wall -Wextra -Wpedantic
DBG_FLAGS  := -g -O0
CFLAGS     := -std=c11 $(WARN_FLAGS) $(DBG_FLAGS) -MMD -MP

SDL_CFLAGS := $(shell pkg-config --cflags $(PKG))
SDL_LIBS   := $(shell pkg-config --libs   $(PKG))

LDLIBS := $(SDL_LIBS) -lm

.PHONY: all build run clean

all: build

build: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDLIBS)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -c $< -o $@

# Also creates build/ (not a separate rule: it would clash with the 'build' target).
$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

run: build
	./$(TARGET)

# build/ also holds tracked assets, fonts and DLLs; only remove build outputs.
clean:
	rm -rf $(OBJ_DIR) $(TARGET)

-include $(DEPS)
